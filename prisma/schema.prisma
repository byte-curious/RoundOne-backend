// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Verdict {
  AC
  WA
  RTE
  TLE
  CE // compilation ERROR
  MLE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resume     Resume?
  sessions   Session[]
  progress   Progress[]
  submission Submission[]
}

model OTPVerification {
  id        String   @id @default(uuid())
  name      String
  password  String
  email     String   @unique
  otp       Int
  expiredAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetOTP {
  email     String   @id
  otp       Int
  expiredAt DateTime
}

model Resume {
  id            String   @id @default(uuid())
  userId        String   @unique
  publicId      String
  fileUrl       String
  extractedText String   @db.Text
  originalName  String
  uploadedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  company    String
  role       String
  level      String
  language   String
  totalScore Int
  createdAt  DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]
}

model Evaluation {
  id              String   @id @default(uuid())
  sessionId       String
  round           String // "hr", "technical", or "dsa"
  question        String   @db.Text
  candidateAnswer String   @db.Text
  score           Int
  maxScore        Int
  feedback        String   @db.Text
  strongPoints    String[]
  improvements    String[]
  suggestion      String   @db.Text
  createdAt       DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Progress {
  id          String   @id @default(uuid())
  userId      String
  sheetId     String
  taskId      String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, sheetId]) // ae is liye ki ek banda ek sheet me ek hi task perform kar paye
}

model Question {
  id          String     @id @default(uuid())
  slug        String     @unique
  title       String
  description String @db.Text
  difficulty  Difficulty
  topics      String[]
  companies   String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  testCases  TestCase[]
  pods       POD[]
  submission Submission[]
}

model TestCase {
  id             String  @id @default(uuid())
  input          String  @db.Text 
  expectedOutput String @db.Text
  isHidden       Boolean // kuchh test case hi visible honge rest all are hidden
  questionId     String

  question Question @relation(references: [id], fields: [questionId], onDelete: Cascade)
}

model Submission {
  id           String   @id @default(uuid())
  questionId   String
  userId       String
  code         String   @db.Text
  language     String
  verdict      Verdict
  userApproach String?  @db.Text
  createdAt    DateTime @default(now())

  // AI KO CALL KARKE JO TC SC AND FEEDBACK AAYEGA ->
  timeComplexity  String?
  spaceComplexity String?
  aiFeedback      String? @db.Text

  // relationship
  user     User     @relation(references: [id], fields: [userId], onDelete: Cascade)
  question Question @relation(references: [id], fields: [questionId], onDelete: Cascade)
}

model POD {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  questionId String

  question Question @relation(references: [id], fields: [questionId], onDelete: Cascade)
}
